NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key di Supabase — Project Settings → API → "service_role".
# Bypassa la RLS: serve SOLO lato server (app/admin/maestre/actions.ts,
# lib/supabase/admin.ts) per creare/eliminare utenti direttamente dall'app
# invece che dal dashboard Supabase (specs/03 - utenti-e-ruoli.md).
# NON prefissarla con NEXT_PUBLIC_, NON committarla mai qui con un valore
# reale, NON usarla in nessun componente client.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile — captcha su /recupera-password (specs/02 - password-recovery.md)
# Site key: pubblica, va bene esposta lato client (embedded nell'HTML).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key: da Cloudflare Dashboard → Turnstile → il tuo widget → "Secret Key".
# NON committare mai un valore reale qui. Vedi TASKS.md per come impostarla
# in locale (.env.local) e su Vercel.
TURNSTILE_SECRET_KEY=

# Resend (https://resend.com) — invio notturno dei report
# giornaliero/settimanale/mensile in PDF (specs/52 -
# report-email-automatico.md), via fetch HTTP diretto (nessun pacchetto
# npm aggiuntivo per l'invio; la generazione dei PDF usa "pdf-lib").
# Piano gratuito sufficiente per un invio al giorno. NON committare mai
# un valore reale qui.
RESEND_API_KEY=
# Mittente da usare nell'email — opzionale, default onboarding@resend.dev
# (sandbox Resend) finché non si verifica un dominio proprio.
RESEND_MITTENTE=

# Destinatario del report notturno — opzionale, default
# info@asilosartorio.it se non impostata (specs/52).
REPORT_EMAIL_DESTINATARIO=

# Modalità di invio dei report settimanale/mensile — opzionale, due
# valori ammessi: "sempre" (default, se non impostata o impostata a
# qualunque altro valore) invia entrambi ogni notte "a tutt'oggi";
# "fine_periodo" li invia solo l'ultima notte della settimana/del mese
# (specs/52).
REPORT_EMAIL_MODALITA_PERIODICI=

# Secret condiviso con Vercel Cron per proteggere
# /api/cron/report-presenze da chiamate esterne non autorizzate: Vercel
# lo invia da sé come header "Authorization: Bearer <CRON_SECRET>" per i
# cron configurati in vercel.json, una volta impostato come variabile
# d'ambiente del progetto. Genera un valore casuale lungo, es. con
# `openssl rand -hex 32`.
CRON_SECRET=

# Credenziali degli account di test per la suite Playwright (e2e/).
# Account fittizi su un progetto Supabase di TEST, mai su quello di
# produzione: i test scrivono/modificano dati veri (presenze, pasti,
# promemoria, sezioni, bambini). Ogni ruolo mancante fa saltare
# (test.skip) solo i test che lo richiedono, il resto gira comunque.
# Vedi CLAUDE.md, sezione "Test end-to-end (Playwright)".
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_MAESTRA_EMAIL=
E2E_MAESTRA_PASSWORD=
E2E_ASSISTENTE_EMAIL=
E2E_ASSISTENTE_PASSWORD=
E2E_GENITORE_EMAIL=
E2E_GENITORE_PASSWORD=
# Opzionali, per casi di test più specifici:
E2E_MAESTRA_SENZA_SEZIONE_EMAIL=
E2E_MAESTRA_SENZA_SEZIONE_PASSWORD=
E2E_UTENTE_DA_PROMUOVERE_EMAIL=
