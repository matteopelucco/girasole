NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile — captcha su /recupera-password (specs/02 - password-recovery.md)
# Site key: pubblica, va bene esposta lato client (embedded nell'HTML).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key: da Cloudflare Dashboard → Turnstile → il tuo widget → "Secret Key".
# NON committare mai un valore reale qui. Vedi TASKS.md per come impostarla
# in locale (.env.local) e su Vercel.
TURNSTILE_SECRET_KEY=
