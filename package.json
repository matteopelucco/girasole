{
  "name": "girasole",
  "version": "0.82.11",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && npm run check:service-role && npm run check:grant-migrazioni",
    "check:dup": "jscpd",
    "check:service-role": "node --no-warnings --experimental-strip-types scripts/service-role-check.mts",
    "check:grant-migrazioni": "node --no-warnings --experimental-strip-types scripts/grant-migrazioni-check.mts",
    "check:e2e-salva": "node --experimental-strip-types scripts/controlla-click-salva.mts",
    "check:ui": "node --no-warnings --experimental-strip-types scripts/controlla-ui.mts",
    "analyze": "npm run lint && npm run test:unit && npm run check:dup && npm run check:e2e-salva && npm run check:ui",
    "prepare": "git config core.hooksPath .githooks",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:anteprima": "playwright test -c playwright.anteprima.config.ts",
    "test:visivo:riferimento": "playwright test -c playwright.confronto-visivo.config.ts --update-snapshots",
    "test:visivo": "playwright test -c playwright.confronto-visivo.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ical.js": "^2.2.1",
    "next": "^16.4.2",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jscpd": "^5.4.1",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
